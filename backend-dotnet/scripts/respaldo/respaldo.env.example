# =============================================================================
# Plantilla del entorno de exportar-dbo-cotifly.sh (HU-006.7, #31). Copiar a /etc/cotifly/respaldo.env en el worker
# (root:root, chmod 600). Sin valores reales en git. Detalle: DEPLOY.md §6.
# =============================================================================
# Instancia y esquema de ORIGEN (producción; solo lectura).
COTIFLY_RESPALDO_SERVIDOR=tbsdatacenter,1433
COTIFLY_RESPALDO_BASE=dbTarifario_Nexo_Pruebas
COTIFLY_RESPALDO_ESQUEMA=dbo_cotifly
# Login de solo lectura (GRANT SELECT ON SCHEMA::dbo_cotifly), pendiente con el DBA.
COTIFLY_RESPALDO_USUARIO=cotifly_respaldo
# Archivo con la clave en la primera línea (root:root, chmod 600). No poner la clave en este archivo.
COTIFLY_RESPALDO_CLAVE_ARCHIVO=/etc/cotifly/respaldo.clave
# 1 solo si el certificado de tbsdatacenter no es de una CA de confianza (preferible instalar la CA).
COTIFLY_RESPALDO_CONFIAR_CERTIFICADO=0
# Destino y retención: 7 diarios + 4 semanales (domingo = 7).
COTIFLY_RESPALDO_DIR=/var/backups/cotifly
COTIFLY_RESPALDO_DIARIOS=7
COTIFLY_RESPALDO_SEMANALES=4
COTIFLY_RESPALDO_DIA_SEMANAL=7
# Imagen con mssql-tools18 (bcp y sqlcmd 18) si el worker no los tiene instalados.
COTIFLY_RESPALDO_IMAGEN=mcr.microsoft.com/mssql/server:2019-latest
