<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Pruebas de aceptación BDD (ADR-010): los .feature de backend-dotnet/specs/features ejecutados con
    Reqnroll sobre xUnit v3 (Reqnroll.xunit.v3, runner Microsoft.Testing.Platform) contra SQL Server 2019
    en Testcontainers con los repositorios reales.
  -->
  <PropertyGroup>
    <UsaSqlServerPruebas>true</UsaSqlServerPruebas>
    <!-- El code-behind de los .feature (enlazados desde specs/features) se genera en obj/, no junto al .feature. -->
    <ReqnrollUseIntermediateOutputPathForCodeBehind>true</ReqnrollUseIntermediateOutputPathForCodeBehind>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Cotifly.Infraestructura\Cotifly.Infraestructura.csproj" />
    <!-- Escenarios HTTP de /web/* (#12 parte B): la API real en memoria (WebApplicationFactory). -->
    <ProjectReference Include="..\..\src\Cotifly.Api\Cotifly.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Reqnroll.xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" />
  </ItemGroup>
  <ItemGroup>
    <!-- Soporte HTTP y validador del contrato compartidos con Cotifly.Api.Tests. -->
    <Compile Include="..\Cotifly.Api.Tests\Soporte\clsApiWebPruebas.cs" Link="Soporte\clsApiWebPruebas.cs" />
    <Compile Include="..\Cotifly.Api.Tests\Soporte\clsValidadorEsquemaOpenApi.cs" Link="Soporte\clsValidadorEsquemaOpenApi.cs" />
    <None Include="..\..\specs\openapi.yaml" Link="specs\openapi.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fuente de verdad SDD: los .feature viven en specs/features y se enlazan aquí. -->
    <ReqnrollFeatureFiles Include="..\..\specs\features\**\*.feature" Link="Features\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
