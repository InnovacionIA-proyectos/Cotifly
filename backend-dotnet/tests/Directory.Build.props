<Project>
  <!-- Configuración común de los proyectos de prueba (xUnit v3 sobre Microsoft.Testing.Platform + AwesomeAssertions, ADR-010). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <!-- Reportes de CI (#14): opciones report-trx y coverage de Microsoft.Testing.Platform (docs/08-testing.md). -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>
  <!--
    Proyectos con pruebas de integración sobre SQL Server 2019 (Testcontainers, ADR-008/ADR-010):
    se activan con <UsaSqlServerPruebas>true</UsaSqlServerPruebas> en el .csproj. Agrega el paquete,
    el soporte compartido de tests/Comun (contenedor, reloj falso, DI de pruebas) y copia los scripts
    db/migrations_mssql/*.sql a la salida para aplicarlos en el contenedor.
  -->
  <ItemGroup Condition="'$(UsaSqlServerPruebas)' == 'true'">
    <PackageReference Include="Testcontainers.MsSql" />
    <!-- Lectura de los PDF generados (#11): texto, páginas, fuentes e imágenes (tests/Comun/clsLectorPdf). -->
    <PackageReference Include="PdfPig" />
    <Compile Include="$(MSBuildThisFileDirectory)Comun\**\*.cs" Link="Comun\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(MSBuildThisFileDirectory)..\..\db\migrations_mssql\*.sql" Link="migrations_mssql\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Datos de prueba portados del Python: muestra de RentabClienteSet de SAP TM (#13) y payload del PDF (#11, ejemplo-solicitud.json). -->
    <None Include="$(MSBuildThisFileDirectory)fixtures\**\*.json" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Pliego de 300 líneas de Nexo (HU-011): paridad de la detección de filas con el analizador de Nexo. -->
    <None Include="$(MSBuildThisFileDirectory)fixtures\**\*.xlsx" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- JWT de Google Chat firmados con un certificado falso (#12 parte C): válido y con la firma de otra clave. -->
    <None Include="$(MSBuildThisFileDirectory)fixtures\chat\*.txt" Link="fixtures\chat\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
