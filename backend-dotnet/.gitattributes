# Finales de línea normalizados a LF en el repositorio (build y contenedores Linux).
* text=auto eol=lf
*.sh text eol=lf

# Binarios: sin conversión ni diff de texto.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.xlsx binary
*.docx binary
