# HU-042.1 (#242). Variables de entorno de db/jobs/sincronizar_margen_sap.ps1.
# Copiar este archivo a ".env" en esta misma carpeta y llenar los valores reales. ".env" queda
# ignorado por git (ver .gitignore de la raíz) — las claves NUNCA se suben al repo.

# --- SAP TM OData (RentabClienteSet). Obligatorias. ---
SAP_TM_URL=http://sap-tm-prd.boterosoto.local:8000/sap/opu/odata/sap/ZGW_RENTAB_CLI_SRV/RentabClienteSet
SAP_TM_USER=<usuario SAP TM>
SAP_TM_PASSWORD=<clave SAP TM>

# --- DW DWCubosOperacionesEBS (NIT por BP, dbo.DimBPSolicitante). Base DISTINTA de DWCubosEBSSAP,
#     la que ya usa el backend para DimEjecutivo. ---
NEXO_DW_SQL_SERVER=10.10.40.24
NEXO_DW_SQL_PORT=1433
NEXO_DW_SQL_DATABASE=DWCubosOperacionesEBS
NEXO_DW_SQL_USER=consultascubos
NEXO_DW_SQL_PASSWORD=<clave de consultascubos>

# --- Base destino (Cotifly). Login SQL, no autenticación de Windows (igual que usa el propio
#     backend para ConnectionStrings:Cotifly). Puede ser un login nuevo, de solo los permisos que
#     necesita este job, o reusar cotifly_app si así se decide. ---
COTIFLY_SQL_SERVER=.
COTIFLY_SQL_DATABASE=<nombre de la base, ej. dbTarifario_Nexo_Pruebas>
COTIFLY_SQL_USER=<usuario SQL del destino>
COTIFLY_SQL_PASSWORD=<clave del usuario SQL del destino>

# --- Cada cuánto sincroniza de verdad, en minutos (el SQL Agent Job intenta correr cada hora;
#     esta variable decide si de verdad toca). 1440 = 24h. ---
SYNC_INTERVAL_MINUTOS=1440
