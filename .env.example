# Plantilla de variables de entorno del Bot Cotizador (Cotifly).
# Copia este archivo a `.env` y llena los valores reales — `.env` nunca se comitea
# (ver .gitignore). Ningún valor de este archivo es una credencial real.
#
# Ver `shared/config.py` (clase Settings) para el detalle de cada campo.

# --- General ---
ENTORNO=local
LOG_LEVEL=INFO

# --- Base de datos (Postgres, BD viva de la app) ---
DATABASE_URL=postgresql+psycopg://bot:bot@localhost:5432/botcotizador

# --- SQL Server 2019 corporativo (HU-002.4) ---
# Solo para el script de creación del esquema objetivo contra `dbTarifario_Nexo_
# Pruebas` (host `tbsdatacenter`, schema `dbo_cotifly`) — no reemplaza DATABASE_URL,
# Postgres sigue siendo la BD viva hasta el corte real. Windows Authentication
# (trusted_connection=yes, sin usuario/contraseña) — este script se corre directo
# desde Windows (sqlcmd -E o Python local), no desde los contenedores Docker (Linux),
# donde Windows Auth no funciona sin Kerberos aparte.
SQLSERVER_DATABASE_URL=mssql+pyodbc://tbsdatacenter/dbTarifario_Nexo_Pruebas?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# --- MCP Server ---
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_AUTH_TOKEN=cambiar-en-despliegue
# Vacío = MCP in-process (dev/tests); en despliegue apunta al overlay interno.
MCP_URL=

# --- Orquestador ---
ORQUESTADOR_HOST=0.0.0.0
ORQUESTADOR_PORT=8000
PDF_STORAGE_MODO=volumen
PDF_STORAGE_DIR=/data/pdfs
# --- S3/MinIO (si PDF_STORAGE_MODO=s3) ---
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=bot-cotizador-pdfs
S3_SECURE=false
PDF_BASE_URL=https://bot-cotizador.boterosoto.local
# Vacío = endpoints internos de soporte deshabilitados (responden 404).
INTERNAL_API_TOKEN=
WEB_SESSION_SECRET=dev-secret-cambia
SESION_BARRIDO_SEG=3600

# --- Sesiones conversacionales ---
SESION_TTL_HORAS=24
SESION_LIMITE_TOKENS=6000

# --- LLM (agnóstico del proveedor vía LiteLLM) ---
LLM_MODEL=gemini/gemini-2.5-flash
LLM_API_KEY=
LLM_MAX_TOKENS=4096
AGENTE_MAX_ITERACIONES=12
LLM_RPM=8
LLM_NUM_RETRIES=4
# Cadena de fallback, separada por comas (ver comentario en shared/config.py).
LLM_FALLBACKS=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=

# --- SAP TM ---
SAP_TM_MODO=export_json
SAP_TM_EXPORT_PATH=tests/fixtures/sap/rentab_cliente_muestra.json
SAP_TM_URL=
SAP_TM_USER=
SAP_TM_PASS=
SAP_SALES_ORG_DEFAULT=50000005

# --- Tarifario (Google Drive) ---
TARIFA_PROVIDER_DEFAULT=drive_flat_files
TARIFA_CACHE_TTL_SEG=21600
TARIFA_LOCAL_DIR=/data/tarifas
GOOGLE_SA_JSON=
DRIVE_TARIFARIO_FOLDER_ID=
DRIVE_CACHE_DIR=/data/tarifas_cache
DRIVE_TARIFARIO_FILE_ID=

# --- API Fletes del Tarifario (contrato aún provisional) ---
API_FLETES_URL=
API_FLETES_TOKEN=
API_FLETES_TIMEOUT_SEG=10

# --- Correo ---
CORREO_HABILITADO=false
CORREO_MODO=smtp_relay
SMTP_RELAY_HOST=10.10.40.62
SMTP_RELAY_PORT=25
SMTP_RELAY_FROM_FALLBACK=notificaciones@boterosoto.com.co
WSCORREOS_URL=http://tbsservicios/WSSCVReporteCelular/wscorreos.asmx
WSCORREOS_TIMEOUT_SEG=20
WSCORREOS_ADJUNTO_DIR_LOCAL=/data/correo_tmp
WSCORREOS_ADJUNTO_DIR_REMOTO=D:\bot-cotizador
# --- SMTP (alternativa a wscorreos) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cotizaciones@boterosoto.com.co

# --- Sincronización a Google Sheets (tablero Looker Studio) ---
SHEETS_HABILITADO=false
SHEETS_SPREADSHEET_ID=
SHEETS_SYNC_INTERVALO_SEG=900

# --- Google Chat ---
GCHAT_PROJECT_NUMBER=
GCHAT_VERIFICAR_JWT=true
GCHAT_SUPPORT_SPACE=
